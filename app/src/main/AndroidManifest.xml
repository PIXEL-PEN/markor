<!-- Do NOT run auto format on this file -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="jelly_bean">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!--
      No INTERNET permission, deliberately.

      This is an offline archive, and the strongest way to say so is to make it unable to do
      otherwise: without the permission the WebView preview cannot fetch a remote image, no
      library can quietly call home, and the guarantee holds even for code nobody has read.
      It is also visible to the user on the Play listing, where a promise in a description is
      not.

      Nothing needed it. GsNetworkUtils had no callers, isConnectedToInternet and
      isWifiConnected had none either, and opening a link hands off to the browser through an
      Intent, which needs no permission of ours. The WebView also blocks network loads at the
      settings level, so a note containing a remote image fails closed rather than relying on
      the permission alone.

      REQUEST_INSTALL_PACKAGES went with it: that existed so Markor could install an .apk it
      had been handed, which is not something a journal does.
    -->
    <uses-permission android:name="android.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ApplicationObject"
        android:allowBackup="true"
        android:appCategory="productivity"
        android:fullBackupContent="@xml/full_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"

        android:isGame="false"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.Unified.StartupFlash"
        android:usesCleartextTraffic="true"
        tools:targetApi="o">

        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <activity
            android:name=".activity.openeditor.OpenFromShortcutOrWidgetActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateUnchanged|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.SearchActivity"
            android:exported="false"
            android:label="@string/search"
            android:parentActivityName=".activity.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.GuideActivity"
            android:exported="false"
            android:label="@string/guide"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.TimelineActivity"
            android:exported="false"
            android:label="@string/timeline"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.FileBrowserActivity"
            android:exported="false"
            android:label="@string/home"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Viewer" />

        <activity
            android:name=".activity.YearEntryActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.WelcomeActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".activity.StoragePermissionActivity"
            android:exported="false"
            android:label="@string/permissions"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.ActionButtonSettingsActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.SettingsActivity" />
        </activity>

        <activity
            android:name="other.writeily.widget.WrWidgetConfigure"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.DocumentActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".activity.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <receiver
            android:name="other.writeily.widget.WrMarkorWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/autumn_widget" />
        </receiver>
        <service
            android:name="other.writeily.widget.WrFilesWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Activities continued here… -->

        <!-- REMOVED: .activity.FileOpenActivity was declared here with a broad VIEW
             intent-filter, but no such class exists anywhere in the project. The manifest
             merger does not verify that, so the build succeeded and the activity was
             advertised to the whole system; any external app opening a .mdwn/.mkd file,
             or the HTML branch in FolderTreeAdapter, hit a ClassNotFoundException.
             Markdown/plaintext files are already handled by OpenFromShortcutOrWidgetActivity
             and DocumentActivity. -->

        <!-- Leading dot: explicitly qualified against the manifest namespace, so the component
             name is unambiguous and follows the namespace if it is renamed. The code side
             derives the same string from BuildConfig's package. See
             AutumnContextUtils.applySpecialLaunchersVisibility(). -->
        <activity-alias
            android:name=".AliasDocumentProcessText"
            android:label="@string/app_name"
            android:exported="true"
            android:targetActivity=".activity.DocumentActivity"
            android:enabled="true">

            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity-alias>
    </application>

    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.google.android.apps.chrome" />
        <package android:name="org.chromium.chrome" />
        <package android:name="org.mozilla.fennec_fdroid" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fennec_aurora" />
        <package android:name="org.mozilla.klar" />
        <package android:name="org.mozilla.focus" />

        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
