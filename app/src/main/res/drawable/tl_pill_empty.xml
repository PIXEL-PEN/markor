<?xml version="1.0" encoding="utf-8"?>
<!--
  A year with no highlight yet. Dashed, like the year overview's empty slots, so it reads as a
  place for one rather than as a highlight that happens to be blank.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="#5A6B6E"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="14dp" />
</shape>
