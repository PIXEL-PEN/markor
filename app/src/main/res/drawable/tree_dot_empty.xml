<?xml version="1.0" encoding="utf-8"?>
<!--
  Badge on a long-titled note with nothing past the date stamp: outline only.
  Was `.dot-flag.empty { background:transparent; border:1px solid #d35400 }`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/tree_accent" />
</shape>
