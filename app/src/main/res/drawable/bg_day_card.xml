<?xml version="1.0" encoding="utf-8"?>
<!-- A white card on a white page needs both a shadow and a line. The shadow alone vanished
     at 7dp of elevation; the stroke is what actually gives the card an edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <stroke android:width="1dp" android:color="@color/day_card_stroke" />
    <corners android:radius="15dp" />
</shape>
