<?xml version="1.0" encoding="utf-8"?>
<!--
  An unfilled highlight slot. Dashed rather than solid so it reads as somewhere a highlight
  goes, not as a highlight that happens to have no name.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="2dp"
        android:color="@color/year_slot_empty"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="5dp" />
</shape>
