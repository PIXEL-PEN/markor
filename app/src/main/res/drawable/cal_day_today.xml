<?xml version="1.0" encoding="utf-8"?>
<!-- Today, when it is not the selected day. Same fixed-size trick as the selected day. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="30dp"
        android:height="30dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/cal_accent" />
        </shape>
    </item>
</layer-list>
