<?xml version="1.0" encoding="utf-8"?>
<!--
  The search field's own container.

  surface_card has a night variant, so this follows the theme without a second copy of the
  drawable. No padding is declared here on purpose: the layout sets it, and a background with
  padding of its own would replace whatever the view had.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_card" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/tree_divider" />
</shape>
