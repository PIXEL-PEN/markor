<?xml version="1.0" encoding="utf-8"?>
<!-- A month box: pale green, thin border, rounded. Was .month-box in the stylesheet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/year_month_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/year_month_border" />
    <corners android:radius="5dp" />
</shape>
