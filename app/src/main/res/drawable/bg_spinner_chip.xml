<?xml version="1.0" encoding="utf-8"?>
<!--
  The category control.

  Bold accent text alone was not enough: slate bold on white still reads as plain black bold,
  and nothing about a bare word says it can be tapped. A tinted, bordered chip does.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/cal_chip_bg" />
    <stroke android:width="1dp" android:color="@color/cal_chip_border" />
    <corners android:radius="6dp" />
</shape>
