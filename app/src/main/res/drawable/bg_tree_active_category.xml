<?xml version="1.0" encoding="utf-8"?>
<!-- A tinted row with a band down the leading edge: the band colour across the whole shape,
     then the tint laid over it inset from the start so only a 4dp strip shows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tree_active_band" />
        </shape>
    </item>
    <item android:start="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tree_active_bg" />
        </shape>
    </item>
</layer-list>
