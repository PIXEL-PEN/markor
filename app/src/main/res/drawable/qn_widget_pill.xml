<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quicknote widget's bar, and the entry box drawn over it: the note field's cream.
  12dp corners: rounder than that and the corner cuts into the logo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/note_field_bg" />
    <stroke android:width="1dp" android:color="@color/note_field_border" />
    <corners android:radius="12dp" />
</shape>
