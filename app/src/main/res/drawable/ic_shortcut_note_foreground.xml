<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground of a pinned note's icon (108dp): the leaf, inset so it sits in the middle of the
  cell, and a pencil badge large enough to read at home-screen size, at the lower right
  (52..88dp). Inside a rounded-square mask, which MIUI uses; a fully round mask may trim the
  badge's outer edge.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="12dp"
        android:drawable="@mipmap/ic_launcher_foreground"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
    <item
        android:bottom="20dp"
        android:drawable="@drawable/ic_shortcut_note_badge"
        android:left="52dp"
        android:right="20dp"
        android:top="52dp" />
</layer-list>
