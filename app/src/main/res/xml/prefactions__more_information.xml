<!--suppress AndroidElementNotAllowed -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:title="@string/more">

    <!--
      Every entry that opened a browser is gone: the app page, bug reports, help, rate this app,
      translate, join community and source code. The app has no INTERNET permission, and a
      screen offering seven ways out to the web is the opposite of what an offline archive
      should look like even when the browser does the fetching.

      What stays is local and stays for a reason. The licences are an obligation, not a
      courtesy: this is Apache 2.0 code with third-party dependencies, and the attribution has
      to be reachable from inside the app.
    -->

    <Preference
        android:icon="@drawable/ic_settings_black_24dp"
        android:key="@string/pref_key__more_info__settings"
        android:title="@string/settings" />

    <PreferenceCategory android:title="@string/about">

        <Preference
            android:icon="@drawable/ic_info_black_24dp"
            android:key="@string/pref_key__more_info__contributors_public_info"
            android:summary="@string/contributors_public_add_yourself_description"
            android:title="@string/contributors" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/licenses">
        <Preference
            android:icon="@drawable/ic_copyright_black_24dp"
            android:key="@string/pref_key__more_info__project_license"
            android:title="@string/project_license" />

        <Preference
            android:icon="@drawable/ic_copyright_black_24dp"
            android:key="@string/pref_key__more_info__open_source_licenses"
            android:title="@string/open_source_licenses" />


        <Preference
            android:icon="@drawable/ic_code_black_24dp"
            android:key="@string/pref_key__more_info__copy_build_information"
            android:title="Copy build information" />

    </PreferenceCategory>


</PreferenceScreen> <!-- Screen -->
