<?xml version="1.0" encoding="utf-8"?>
<!-- Four cells wide, one high: a cream bar with the logo at its end. Stretches sideways. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/qn_widget_description"
    android:initialLayout="@layout/widget_quicknote"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="140dp"
    android:previewLayout="@layout/widget_quicknote"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
