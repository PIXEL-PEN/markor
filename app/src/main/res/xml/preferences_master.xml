--><!--suppress AndroidElementNotAllowed -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:title="@string/settings">

    <!-- General screen -->
    <PreferenceScreen
        android:icon="@drawable/ic_file_white_24dp"
        android:summary="@string/files_and_folders"
        android:title="@string/general">

        <!--
          Save Location is gone entirely.

            Notebook   - getNotebookDirectory() silently re-points any path it recognises as
                         one of ours back to the canonical folder, but honours an arbitrary one.
                         So the only thing this control could actually do was strand the archive
                         somewhere the rest of the app does not look. The folder comes from
                         BuildConfig.STORAGE_ROOT_NAME and is not a preference.
            Quicknote  - Markor's single scratch file. Autumn has its own quick note, which
                         writes a dated entry into the archive; two unrelated things under one
                         name.
            ToDo       - a task list, which is not what this app is.
        -->

        <!--
          Search is gone. Max search depth read getMaxSearchDepth(), which had no callers at
          all: Autumn's ArchiveSearch walks the archive with its own cap of twelve. The ignore
          list belonged to Markor's file search, not to the search on the Tree and Year screens.
        -->

        <PreferenceCategory android:title="@string/features">
            <CheckBoxPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_highlight_black_24dp"
                android:key="@string/pref_key__is_highlighting_activated"
                android:summary="@string/highlighting_enabled_or_not__appspecific"
                android:title="@string/syntax_highlighting" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_highlight_black_24dp"
                android:key="@string/pref_key__is_dynamic_highlighting_activated"
                android:summary="@string/dynamic_highlighting_effect"
                android:title="@string/dynamic_highlighting" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:icon="@drawable/ic_border_outer_black_24dp"
                android:key="@string/pref_key__is_multi_window_enabled"
                android:summary="@string/open_new_documents_always_in_new_window"
                android:title="@string/multiple_windows" />
        </PreferenceCategory>

    </PreferenceScreen>

    <!-- Document browser screen -->

    <!-- Editor screen -->
    <PreferenceScreen
        android:icon="@drawable/ic_edit_black_24dp"
        android:summary="@string/editor_settings"
        android:title="@string/edit_mode">
        <net.gsantner.opoc.frontend.settings.GsFontPreferenceCompat
            android:defaultValue="@string/default_font_family"
            android:icon="@drawable/ic_format_shapes_black_24dp"
            android:key="@string/pref_key__font_family"
            android:title="@string/font" />
        <androidx.preference.SeekBarPreference
            android:defaultValue="15"
            android:icon="@drawable/ic_format_size_black_24dp"
            android:key="@string/pref_key__editor_font_size"
            android:max="36"
            android:min="5"
            android:summary="@string/control_font_size_in_editor"
            android:title="@string/font_size"
            app:showSeekBarValue="true" />

        <androidx.preference.SeekBarPreference
            android:defaultValue="1"
            android:icon="@drawable/ic_keyboard_tab_black_24dp"
            android:key="@string/pref_key__tab_width_v2"
            android:max="12"
            android:summary="@string/amount_of_space_for_tab"
            android:title="@string/tab_width"
            app:min="1"
            app:showSeekBarValue="true" />

        <!--
          Basic colour scheme is gone: four colour pickers for editor foreground and background
          in light and dark, plus seven presets that wrote into them.

          It overrode the theme with stored values and offered no way back to the theme's own
          colours, so a preset that landed badly left the editor unreadable with no reset. The
          getters already fell back to primary_text and background when nothing was stored;
          they now use those always, and values-night maps both, so dark mode is handled by the
          resource system rather than by a night check reading a different preference.
        -->

        <PreferenceCategory android:title="@string/syntax_highlighting">
            <CheckBoxPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_format_color_fill_black_24dp"
                android:key="@string/pref_key__is_highlighting_for_hexcolor_activated"
                android:summary="@string/underline_hex_color_wether_or_not_to_description__appspecific"
                android:title="@string/underline_hex_color_codes" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_format_color_fill_black_24dp"
                android:key="@string/pref_key__editor_disable_spelling_red_underline"
                android:summary="@string/spellcheck_keyboard_suggestion_stay_red_underline_vanishes"
                android:title="@string/disable_spelling_underline" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:icon="@drawable/ic_code_black_24dp"
                android:key="@string/pref_key__highlight_code_monospace_font"
                android:summary="@string/use_different_fonttype_slow_down"
                android:title="@string/use_monospace_for_code" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:icon="@drawable/ic_code_black_24dp"
                android:key="@string/pref_key__highlight_code_block_disabled"
                android:title="@string/disable_code_block_highlight" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:icon="@drawable/ic_format_size_black_24dp"
                android:key="@string/pref_key__editor_markdown_bigger_headings_3"
                android:summary="@string/increase_text_size_of_headings_according_to_level"
                android:title="@string/bigger_headings" />
        </PreferenceCategory>

        <PreferenceCategory android:title="@string/miscellaneous">
            <androidx.preference.SeekBarPreference
                android:defaultValue="100"
                android:icon="@drawable/ic_format_line_spacing_black_24dp"
                android:key="@string/pref_key__editor_line_spacing"
                android:max="250"
                android:summary="@string/space_between_lines_in_percent"
                android:title="@string/line_spacing"
                app:min="50"
                app:showSeekBarValue="true" />
            <androidx.preference.SeekBarPreference
                android:defaultValue="8"
                android:icon="@drawable/ic_space_bar_black_24dp"
                android:key="@string/pref_key__editor_textaction_bar_item_padding"
                android:max="32"
                android:summary="@string/horizontal_space_between_actionbuttons"
                android:title="@string/actionbutton_spacing"
                app:min="0"
                app:showSeekBarValue="true" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_visibility_black_24dp"
                android:key="@string/pref_key__editor_enable_line_breaking"
                android:summary="@string/soft_break_if_not_fit_to_width_else_enable_horizontal_scrolling"
                android:title="@string/wrap_words" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:icon="@drawable/ic_filter_center_focus_black_24dp"
                android:key="@string/pref_key__editor_start_editing_in_center"
                android:summary="@string/edit_text_in_center_of_screen"
                android:title="@string/center_text" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_keyboard_tab_black_24dp"
                android:key="@string/pref_key__editor_tab_to_indent"
                android:title="@string/use_tab_to_indent" />
            <ListPreference
                android:defaultValue="-"
                android:dialogTitle="@string/theme"
                android:entries="@array/pref_arrdisp__unordered_list_character"
                android:entryValues="@array/pref_arrkeys__unordered_list_character"
                android:icon="@drawable/ic_list_black_24dp"
                android:key="@string/pref_key__editor_unordered_list_character"
                android:summary="@string/character_to_start_items_of_unordered_list_with"
                android:title="@string/unordered_list_character" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- View screen -->
    <!-- View mode had seven preferences and none of them needed to be a preference.
         Mode on open is now a rule, not a setting: browsing opens in view mode, the
         entry points that exist for writing open the editor, and the top bar toggle
         switches between them. The other six still work, from their defaults: the
         renderer takes the link colour, RTL rendering, the injected head and body, and
         a view font size that follows the editor's. Swipe to change mode stays off;
         the toggle is the control. -->

    <!-- Formats screen -->
    <!-- One format left that has anything worth setting. If it stays a single item
         it could fold into Edit mode next to the action button spacing. -->
    <PreferenceCategory android:title="@string/format">

        <!-- Markdown screen. Six of the seven preferences here were obscure and all six
             still work from their defaults: the highlighting delay, hard line break
             highlighting, KaTeX math, the table of contents and the YAML front matter keys.
             Newline as line break is no longer optional, it is always on. What is left is
             the action button order, which is worth reaching. -->
        <PreferenceScreen
            android:icon="@drawable/gs_markdown_black_24dp"
            android:title="@string/markdown">

            <PreferenceCategory android:title="@string/actionbutton">
                <Preference
                    android:icon="@drawable/ic_reorder_black_24dp"
                    android:key="@string/pref_key__markdown__reorder_actions"
                    android:title="@string/action_order" />
            </PreferenceCategory>

        </PreferenceScreen>

        <!-- To-Do Screen -->

        <!-- Plaintext Screen -->
        
        <!-- asciidoc Screen -->
                <!-- OrgMode Screen -->
            </PreferenceCategory>

    <!-- Most important settings -->
    <!-- Keep screen on and disallow screenshots used to sit behind an "Other" screen of
         their own, two items deep. They are app-wide behaviour, so they belong next to the
         theme. -->
    <PreferenceCategory android:title="@string/essential">
        <CheckBoxPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_screen_lock_portrait_black_24dp"
            android:key="@string/pref_key__is_keep_screen_on"
            android:title="@string/keep_screen_on" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_lock_outline_black_24dp"
            android:key="@string/pref_key__is_disallow_screenshots"
            android:title="@string/disallow_screenshots" />

        <ListPreference
            android:defaultValue="system"
            android:entries="@array/pref_arrdisp__app_themes"
            android:entryValues="@array/pref_arrkeys__app_themes"
            android:icon="@drawable/ic_invert_colors_black_24dp"
            android:key="@string/pref_key__app_theme"
            android:summary="%1$s"
            android:title="@string/theme" />
                        <!-- Language is gone. There are 63 locale folders here, inherited from Markor, and
             none of them carries Autumn's own strings: the Calendar, Tree, Year, Timeline and
             category text is English only, and roughly a hundred upstream strings were never
             translated either. Picking a language produced a patchwork rather than a
             translated app. resConfigs in build.gradle now pins the build to English, so the
             folders stay in the repo for a real localisation pass later without shipping. -->
    </PreferenceCategory>


    <!-- Moved here from the More tab, which is now this screen. The licences are an
         obligation rather than a courtesy: this is Apache 2.0 code with third-party
         dependencies and the attribution has to be reachable from inside the app. -->
    <PreferenceCategory android:title="@string/about">
        <!-- Contributors was a 56-line roster of Markor contributors carrying 33 GitHub
             links, inviting you to add yourself. Apache 2.0 asks that copyright and
             attribution notices be retained, which the licence rows below do; it does not
             ask for a contributor roster, and a list of web links does not belong in an
             app with no network access. The roster stays in CONTRIBUTORS.md. -->
        <!-- Autumn's own copyright, stated on the screen rather than only inside the licence
             dialog. Not selectable: there is nothing to open, it is the line itself. -->
        <Preference
            android:icon="@drawable/ic_copyright_black_24dp"
            android:selectable="false"
            android:title="@string/app_copyright" />

        <!-- Strictly Autumn's own licence. The Apache and MIT notices for the inherited code
             used to sit in here too, which made a row called Project license open a dialog
             mostly about two other projects. They were already listed in full under Open
             source licences, so this now carries one sentence of provenance and points
             there. -->
        <Preference
            android:icon="@drawable/ic_copyright_black_24dp"
            android:key="@string/pref_key__more_info__project_license"
            android:title="@string/project_license" />
        <Preference
            android:icon="@drawable/ic_copyright_black_24dp"
            android:key="@string/pref_key__more_info__open_source_licenses"
            android:title="@string/open_source_licenses" />
        <Preference
            android:icon="@drawable/ic_code_black_24dp"
            android:key="@string/pref_key__more_info__copy_build_information"
            android:title="Build information" />
    </PreferenceCategory>

</PreferenceScreen> <!-- Screen -->
