<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="net.pixelpen.journal.activity.MainActivity"
    tools:ignore="AlwaysShowAction">

    <!--
      Search lived in the file browser's own menu and went with it. A visible action item, shown
      on the Calendar and Tree screens; collapseActionView so the field expands over the bar when
      opened and hands the query back when closed, which is what clears the results.
    -->
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_black_24dp"
        android:orderInCategory="10"
        android:title="@string/search"
        android:visible="false"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="always|collapseActionView" />

    <!-- First in the overflow: back up to the top of the archive. -->
    <item
        android:id="@+id/action_home"
        android:icon="@drawable/ic_home_black_24dp"
        android:orderInCategory="1"
        android:title="@string/home"
        android:visible="false"
        app:showAsAction="never" />

    <!--
      Search from a screen that cannot show results in place. Opens the search screen; the Tree
      has its own field, where matches replace the tree itself.
    -->
    <item
        android:id="@+id/action_search_screen"
        android:icon="@drawable/ic_search_black_24dp"
        android:orderInCategory="11"
        android:title="@string/search"
        android:visible="false"
        app:showAsAction="always" />

    <!-- Somewhere you go deliberately, rather than a tab flicked to while capturing. -->
    <item
        android:id="@+id/action_timeline"
        android:icon="@drawable/ic_history_black_24dp"
        android:orderInCategory="2"
        android:title="@string/timeline"
        android:visible="false"
        app:showAsAction="never" />

    <!--
      A copy of the whole archive, handed to the share sheet. Not a format of its own: the folder
      of markdown is already the backup, and this only picks it all up at once.
    -->
    <item
        android:id="@+id/action_backup"
        android:icon="@drawable/ic_save_black_24dp"
        android:orderInCategory="50"
        android:title="@string/backup_now"
        android:visible="false"
        app:showAsAction="never" />

    <!--
      In the overflow rather than gated behind a preference, so the bar has a menu at all. Its
      visibility follows the tab, which is what puts the overflow on the Calendar and Tree screens
      and leaves it off the More screen, where it would only point back at itself.
    -->
    <item
        android:id="@+id/action_guide"
        android:icon="@drawable/ic_info_black_24dp"
        android:orderInCategory="190"
        android:title="@string/guide"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings_black_24dp"
        android:orderInCategory="100"
        android:title="@string/settings"
        android:visible="false"
        app:showAsAction="never" />

</menu>

