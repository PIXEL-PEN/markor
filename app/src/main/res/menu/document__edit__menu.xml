  Trimmed for Autumn. This carried about forty-five entries inherited from Markor, most of which
  belong to an app that edits many formats: switching a document between todo.txt, orgmode,
  wikitext, asciidoc, csv and embedded binary; epub conversion; speed-reading; a debug log; and a
  file browser that no longer exists in this app. Also gone are the per-file settings toggles,
  the text-case tools, file info and reload-from-disk.

  What is left is what a journal entry needs: undo and redo, save, the preview/edit switch,
  search within the note, and a way to send it somewhere.

  On the save icon being greyed out: it is enabled only while there are unsaved changes, and the
  editor saves on its own when it is left. Grey means there is nothing to save.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="AlwaysShowAction">

    <item
        android:id="@+id/action_undo"
        android:icon="@drawable/ic_undo_black_24dp"
        android:title="@string/undo"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_redo"
        android:icon="@drawable/ic_redo_black_24dp"
        android:title="@string/redo"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_save"
        android:icon="@drawable/ic_save_black_24dp"
        android:title="@string/save"
        app:showAsAction="always" />

    <!-- Hidden; the two icons below are the switch. Kept because the format plumbing calls it. -->
    <item
        android:id="@+id/action_preview_edit_toggle"
        android:icon="@drawable/ic_visibility_black_24dp"
        android:title="@string/view"
        android:visible="false"
        app:showAsAction="never" />

    <!-- These two swap: whichever mode you are not in is the one offered. -->
    <item
        android:id="@+id/action_preview"
        android:icon="@drawable/ic_visibility_black_24dp"
        android:title="@string/view_mode"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_edit"
        android:icon="@drawable/ic_edit_black_24dp"
        android:title="@string/edit_mode"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_black_24dp"
        android:title="@string/search"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_search_view"
        android:icon="@drawable/ic_search_black_24dp"
        android:title="@string/search"
        app:actionViewClass="android.widget.SearchView"
        app:showAsAction="always" />

    <!--
      The overflow, as one flat list.

      Share used to be a submenu: an icon and the word Share on the overflow, which when opened
      replaced the list with a header saying Share again, a back arrow, and three items named
      Plain Text, Print / PDF and File. Two taps and two spellings of the same word to reach
      something three items long. Flattened, and the items renamed to say what they do on their
      own now that no parent is there to say it for them.

      No icons on these deliberately. tintMenuItems paints menu icons white for the dark action
      bar, which is the wrong colour on a light popup. The share icon was there and not doing
      any good.

      Move to category is hidden unless the file sits in a Year/Month/Category slot, and unless
      the note is being read rather than edited.
    -->
    <item
        android:id="@+id/action_move_to_category"
        android:title="@string/move_to_category"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_share_text"
        android:title="@string/share_as_text"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_share_file"
        android:title="@string/share_as_file"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_share_pdf"
        android:title="@string/save_as_pdf"
        app:showAsAction="never" />

</menu>
