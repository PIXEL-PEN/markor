<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom navigation.

  Order here defines tab order, and MainActivity's tabIdToPos / getPosTitle / getPosFragment
  follow it. SectionsPagerAdapter.getItemCount() is this menu's size. Change one, change all.

  Journal is first so the app opens on capture, not on a file browser.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="net.pixelpen.journal.activity.MainActivity">

    <item
        android:id="@+id/nav_journal"
        android:icon="@drawable/ic_calendar_white_24dp"
        android:title="@string/calendar" />

    <item
        android:id="@+id/nav_tree"
        android:icon="@drawable/ic_baseline_account_tree_24"
        android:title="@string/tree" />

    <item
        android:id="@+id/nav_year"
        android:icon="@drawable/ic_date_range_black_24dp"
        android:title="@string/year" />

    <!-- An action, not a destination. Tapping files whatever is in the Calendar's input
         field; long-pressing opens the month's document. Settings moved to the overflow
         menu, which already had it. -->
    <item
        android:id="@+id/nav_quicknote"
        android:icon="@drawable/ic_lightning_yellow_24dp"
        android:title="@string/quicknote" />
</menu>
