<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- TODO, parked deliberately: Autumn's own eight colours have no night variant, so
         they keep their light values when the theme goes dark. Checked, not guessed:

           year_page_bg       #F4F4F4   Year sets its own background, so the screen stays
           year_header        #005F73   internally readable but becomes a white island
           year_highlight_bg  #E0FBFC   in an otherwise dark app
           cal_title          #2B3545   Calendar, same, and its root background is
           cal_weekday        #8A95A1   @android:color/white, hardcoded, not a resource
           tree_meta          #6E6E6E   Tree inherits the theme background and goes dark
                                        correctly; only this grey metadata gets dim
           tl_page_bg         #EEF2F7   Timeline export is an HTML document in a browser.
                                        White is arguably right. Leave it.
           year_dropdown      #0A9396   mid-tone, likely survives either way

         So the Tree is the screen that already behaves. The job is seven night variants
         and replacing that hardcoded white in fragment_calendar.xml, then testing on
         device.

         The testing surface is no longer tripled by upstream oddities: Auto, Auto
         (09:00 - 17:00), Dark and Black have all been removed from the Theme preference,
         which now offers System and Light only. Both resolve to light on a phone set to
         light, so this file currently has no effect on anything. It is kept because the
         nine mappings below are correct and would have to be rewritten otherwise, and
         because this note is the specification for putting Dark back. -->


    <!-- Named colors -->
    <color name="colorPrimary">@color/primary_dark</color>
    <color name="primary_text">@color/white</color>
    <color name="secondary_text">@color/dark__secondary_text</color>
    <color name="file">@color/dark__file</color>
    <color name="folder">@color/dark__folder</color>
    <color name="background">@color/dark__background</color>
    <color name="background_2">@color/dark__background_2</color>
    <color name="textActionBarColor">@color/dark__background_2</color>
    <color name="textActionIconColor">@color/white</color>

    <!-- All values specified only in base colors.xml  -->

</resources>