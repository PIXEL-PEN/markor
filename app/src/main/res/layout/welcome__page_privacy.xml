<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_panel_bg"
            android:gravity="center"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="64dp"
                    android:layout_height="14dp"
                    android:background="@drawable/welcome_folder_tab" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:background="@drawable/welcome_folder"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/welcome__file1"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/welcome_file_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/welcome_demo_file"
                        android:textColor="@color/welcome_band_text"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/welcome__file2"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/welcome_file_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/welcome_demo_file"
                        android:textColor="@color/welcome_band_text"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/welcome__file3"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/welcome_photo_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/welcome_demo_photo"
                        android:textColor="@color/welcome_highlight_text"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/welcome_demo_folder"
                    android:textColor="@color/welcome_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="26dp"
                android:background="@drawable/welcome_offline_bg">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/welcome_ic_wifi_off" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/welcome_privacy_title"
            android:textColor="@color/welcome_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/welcome_ic_check" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/welcome_privacy_1"
                android:textColor="@color/welcome_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/welcome_ic_check" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/welcome_privacy_2"
                android:textColor="@color/welcome_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/welcome_ic_check" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/welcome_privacy_3"
                android:textColor="@color/welcome_text"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
