<?xml version="1.0" encoding="utf-8"?>
<!--
  The category spinner's closed state, on the teal bar.

  Android's simple_spinner_item takes its colour from the theme, which put near-black text on a
  mid-teal background and offered nothing to show it could be opened. White text and an explicit
  caret, as the original stylesheet had.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:drawableEnd="@drawable/ic_arrow_drop_down_white_24dp"
    android:drawablePadding="2dp"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp"
    android:singleLine="true"
    android:textColor="@android:color/white"
    android:textSize="15sp"
    android:textStyle="bold" />
