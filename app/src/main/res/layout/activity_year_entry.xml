<?xml version="1.0" encoding="utf-8"?>
<!--
  Editing one year of the timeline.

  The months are labels, not text in the document. Seeded into the markdown they were editable,
  so the cursor could land in one and a month could be renamed or deleted by accident while
  typing an entry. Here they are fixed furniture down the left and only the fields beside them
  take input.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tl_entry_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/year_entry_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/tl_header"
        android:paddingEnd="10dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!--
      Pictures for the year, above the months.

      Not a text field. A field would hold markdown links, which is punctuation to type around
      and a cursor trap; and the months would imply a picture belongs to one, which the timeline
      does not record and does not show.
    -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tl_entry_bg"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/year_entry_shots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/year_entry_months"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />

    </ScrollView>

</LinearLayout>
