<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:theme="@style/AppTheme.Unified"
    tools:context="net.pixelpen.journal.activity.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/AppTheme.Light.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/LightTextToolbarOverlay"
            app:subtitleTextColor="@color/secondary_text"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main__view_pager_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="?attr/actionBarSize" />

    <!-- Browse. Opens the Tree already showing the category the spinner is set to, so you can
         look at what is in a category without making an entry to get there. Journal tab only;
         see MainActivity.onViewPagerPageSelected. -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/fab_browse"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/bg_browse_button_ripple"
        android:clickable="true"
        android:contentDescription="@string/browse"
        android:drawableEnd="@drawable/ic_baseline_keyboard_double_arrow_right_24"
        android:drawablePadding="2dp"
        android:drawableTint="@android:color/white"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:text="@string/browse"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_new_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/create_new_file_or_folder"
        android:src="@drawable/ic_add_white_24dp"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.Material3.FloatingActionButton" />

    <!-- The calendar FAB was removed: Journal is the first tab now. -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="start|bottom"
        android:background="@color/primary"
        app:itemBackground="@color/primary"
        app:itemIconTint="@drawable/bottomnav_color_selector"
        app:itemTextColor="@drawable/bottomnav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main__bottom_nav" />

</FrameLayout>
