<?xml version="1.0" encoding="utf-8"?>
<!--
  The life timeline, off the overflow menu rather than the bottom bar.

  It is a place you go to deliberately, for an hour, not something switched between while
  capturing notes, and five bottom tabs for a four-tab app crowded the ones used daily.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/timeline_activity_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/tl_header"
        android:paddingEnd="10dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <FrameLayout
        android:id="@+id/timeline_activity_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
