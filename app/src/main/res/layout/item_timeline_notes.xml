<?xml version="1.0" encoding="utf-8"?>
<!--
  A year's bullets. Shown under its bar while the year is open.

  The rows are built in code because the count varies per year; the card is here so its shape and
  spacing do not have to be reconstructed from Java.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/tl_notes_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/tl_notes_bullets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tl_notes_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:padding="6dp"
        android:textColor="@color/tl_header"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
