<?xml version="1.0" encoding="utf-8"?>
<!--
  A year bar: the year on the left, its highlight as a pill on the right.

  The pill is the year's one line, so it is kept short and ellipsized rather than wrapped: a bar
  that grows to three lines stops reading as a bar, and the whole text is a tap away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/tl_year_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tl_year_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1C1C1C"
        android:textSize="18sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tl_year_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/tl_pill"
        android:ellipsize="end"
        android:maxWidth="200dp"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="#3A2F00"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
