<?xml version="1.0" encoding="utf-8"?>
<!--
  One month box. Title, then its events as a bulleted list built in code, because the number of
  rows varies per month and a nested RecyclerView for a handful of lines costs more than it saves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/year_month_box"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/month_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:textColor="@color/tree_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/month_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
