<?xml version="1.0" encoding="utf-8"?>
<!--
  The category spinner's CLOSED state only.

  Plain black at body weight, it read as a label rather than a control, and nothing about it
  said it could be opened. Bold, in the accent, with a caret. The dropdown list keeps
  simple_spinner_dropdown_item, so the items themselves are unchanged.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spinner_item_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:drawableEnd="@drawable/ic_arrow_drop_down_accent_24dp"
    android:drawablePadding="4dp"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp"
    android:singleLine="true"
    android:textColor="@color/cal_accent"
    android:textSize="16sp"
    android:textStyle="bold" />
