<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder Tree as a tab.

  The old activity_folder_browser.xml carried its own black header row with a back arrow and
  title, because it was a standalone Activity. As a fragment inside MainActivity it inherits the
  toolbar and the bottom nav, so the header is gone and back is handled by the pager.

  The WebView is gone too. It rendered the accordion well but reloaded a freshly generated
  document on every visit, after walking the whole archive to build it, so the tab got slower
  as the archive grew, which is backwards for something meant to fill up over years. These rows
  are the same design drawn natively, reading one directory at a time.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/folder_tree_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.FolderTreeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          The folder being browsed. Only shown while browsing: in the tree each row's indentation
          already says where it sits, but a folder listing is one level with no such context, and
          without the path there is nothing on screen to say which folder you are looking at.
        -->
        <TextView
            android:id="@+id/folder_tree_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tree_divider"
            android:ellipsize="start"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/tree_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/folder_tree_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="88dp"
            android:scrollbars="vertical" />

    </LinearLayout>

    <TextView
        android:id="@+id/folder_tree_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textColor="@color/tree_meta"
        android:textSize="15sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/folder_tree_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
