<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app file browser.

  Deliberately NOT the Tree. The Tree shows the whole archive at once, indented and collapsible,
  which is right for seeing shape and wrong for housekeeping. This shows one folder at a time:
  a flat list, a path line saying where you are, and a step up to the parent. The same way a
  desktop file manager works, because that is what deleting a mistyped folder calls for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!--
      The path line doubles as the up control. Going up was only ever on the Back button, which
      works and is invisible: nothing on the screen said the folder had a parent. The arrow sits
      where a file manager puts it, and goes INVISIBLE rather than GONE at the top so the path
      text does not shift sideways as you walk up and down.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cal_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/fb_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/up_one_level"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_arrow_upward_24"
            android:tint="@color/cal_accent" />

        <TextView
            android:id="@+id/fb_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:paddingStart="6dp"
            android:singleLine="true"
            android:textColor="@color/cal_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cal_card_border" />

    <TextView
        android:id="@+id/fb_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/folder_is_empty"
        android:textColor="@color/cal_weekday"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fb_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
