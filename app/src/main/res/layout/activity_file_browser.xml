<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app file browser.

  Deliberately NOT the Tree. The Tree shows the whole archive at once, indented and collapsible,
  which is right for seeing shape and wrong for housekeeping. This shows one folder at a time:
  a flat list, a path line saying where you are, and a step up to the parent. The same way a
  desktop file manager works, because that is what deleting a mistyped folder calls for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/fb_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cal_chip_bg"
        android:ellipsize="start"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:singleLine="true"
        android:textColor="@color/cal_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cal_card_border" />

    <TextView
        android:id="@+id/fb_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/folder_is_empty"
        android:textColor="@color/cal_weekday"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fb_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
