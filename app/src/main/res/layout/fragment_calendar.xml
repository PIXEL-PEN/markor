<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar tab.

  The old layout gave the grid layout_weight="1", so Android's CalendarView stretched to fill
  whatever was left and pushed the form to the floor, straight under the FAB, which floats
  128dp up from the bottom. The grid is wrap_content now and the slack goes to the text field
  instead, which is where a journal wants it: the writing area grows to fill the screen and
  stops 84dp short of the bottom, clearing the FAB rather than sitting under it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    tools:context=".activity.CalendarFragment">

    <net.pixelpen.journal.view.MonthGrid
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_calendar_card"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp" />

    <!-- Category row, with the settings button alongside rather than stranded on its own line. -->
    <LinearLayout
        android:id="@+id/button_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_manage_categories_toolbar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/manage_categories"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_black_24dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/cal_card_border" />

    <EditText
        android:id="@+id/input_note_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="84dp"
        android:minHeight="110dp"
        android:background="@drawable/bg_edittext_amber"
        android:gravity="top|start"
        android:hint="@string/enter_note_title"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="250"
        android:maxLines="10"
        android:overScrollMode="always"
        android:padding="10dp"
        android:scrollHorizontally="false"
        android:scrollbars="vertical"
        android:textColorHint="@color/cal_weekday" />

</LinearLayout>
