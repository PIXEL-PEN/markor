<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context=".activity.CalendarFragment">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/calendar_grid_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F2F2F2">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height=".9dp"
            android:layout_gravity="bottom"
            android:background="#222222" />

        <!-- Browser icon row (lowered slightly toward the spinner) -->
        <LinearLayout
            android:id="@+id/browser_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="0dp">


            <ImageButton
                android:id="@+id/btn_manage_categories_toolbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_settings_black_24dp"
                android:scaleType="centerInside"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/manage_categories"
                android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical"/>


        </LinearLayout>

        <!-- Button + Spinner row -->
        <LinearLayout
            android:id="@+id/button_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="100">

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="22"
                android:text="Reset"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_reset_style" />

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="22"
                android:text="Submit"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_submit_style" />

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="56"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_note_title"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:hint="Enter note title.."
            android:textColorHint="@android:color/darker_gray"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="250"
            android:maxLines="10"
            android:gravity="top|start"
            android:background="@drawable/bg_edittext_amber"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:scrollHorizontally="false" />

    </LinearLayout>
</LinearLayout>
