<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar tab.

  Two things this layout has to survive. The FAB floats 128dp up from the bottom of the window,
  so nothing the user types into may sit under it. And the activity is adjustResize, so when the
  keyboard opens the whole fragment loses roughly half its height.

  The first version solved the FAB by giving the text field layout_weight, which made the second
  problem worse than the one it fixed: a weighted field in a shrinking parent is the first thing
  squeezed, and the keyboard flattened it to nothing. Fixed height inside a ScrollView instead.
  The field keeps its size whatever the window does, and focusing it scrolls it into view above
  the keyboard rather than resizing it out of existence.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".activity.CalendarFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="0dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <!--
          Air above the day, and rather less below it, so the card's base sits just above the
          middle of the screen. Weights rather than fixed gaps: on a shorter phone the two
          spaces give up room in proportion instead of the card being pushed off, and when the
          keyboard opens they are what the ScrollView takes the space from, which leaves the
          note field alone.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.23" />

        <!-- The day card. Rings straddle the top edge, so the card is inset to make room. -->
        <FrameLayout
            android:id="@+id/day_card_frame"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_day_card_ring" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_day_card_ring" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="15dp"
                    android:background="@drawable/bg_day_card_ring" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/day_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:clickable="true"
                android:contentDescription="@string/day_card_description"
                android:focusable="true"
                android:background="@drawable/bg_day_card"
                android:elevation="15dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/day_card_month"
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_day_card_band"
                    android:gravity="center_horizontal|bottom"
                    android:letterSpacing="0.18"
                    android:paddingBottom="5dp"
                    android:textColor="@android:color/white"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    tools:text="NOVEMBER 2026" />

                <TextView
                    android:id="@+id/day_card_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:paddingTop="13dp"
                    android:textColor="@color/day_card_number"
                    android:textSize="58sp"
                    android:textStyle="bold"
                    tools:text="7" />

                <TextView
                    android:id="@+id/day_card_weekday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingBottom="16dp"
                    android:paddingTop="9dp"
                    android:textColor="@color/day_card_weekday"
                    android:textSize="12.5sp"
                    tools:text="Saturday" />


            </LinearLayout>

        </FrameLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Category row, with the settings button alongside rather than on a line of its own. -->
        <LinearLayout
            android:id="@+id/button_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_chip" />

            <ImageButton
                android:id="@+id/btn_manage_categories_toolbar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/manage_categories"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_black_24dp" />

        </LinearLayout>

        <!--
          The clear button sits in the field's top corner, where it does not move as the text
          grows. The field's own paddingEnd is widened to match so a long line wraps before it
          rather than running underneath.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/input_note_title"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_edittext_amber"
                android:gravity="top|start"
                android:hint="@string/enter_note_title"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="250"
                android:maxLines="10"
                android:overScrollMode="always"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="40dp"
                android:paddingBottom="10dp"
                android:scrollHorizontally="false"
                android:scrollbars="vertical"
                android:textColorHint="@color/cal_weekday" />

            <ImageButton
                android:id="@+id/btn_clear_note"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_note_field"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_clear_24"
                android:tint="@color/day_card_weekday"
                android:visibility="gone" />

        </FrameLayout>

        <!--
          Browse reads as a control of its own below the field, in the same chip as the category
          spinner so the two look like one family. It was inside the field's bottom corner, where
          it sat on the box edge and crowded the text.
        -->
        <TextView
            android:id="@+id/btn_browse_tree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_chip"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_baseline_keyboard_double_arrow_right_24"
            android:drawablePadding="4dp"
            android:drawableTint="@color/day_card_weekday"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="@string/browse"
            android:textColor="@color/day_card_weekday"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
