<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context=".activity.CalendarFragment">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/calendar_grid_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F2F2F2">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height=".9dp"
            android:layout_gravity="bottom"
            android:background="#222222" />

        <!-- Browser icon row (lowered slightly toward the spinner) -->
        <LinearLayout
            android:id="@+id/browser_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="0dp">


            <ImageButton
                android:id="@+id/btn_manage_categories_toolbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_settings_black_24dp"
                android:scaleType="centerInside"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/manage_categories"
                android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical"/>


        </LinearLayout>

        <!--
          Category row.

          Reset and Submit sat to the left of this spinner, taking 22 of the row's 100 weight
          each. Submit is the FAB now, and the form resets itself after a save, so the spinner
          has the row to itself: the weights are gone with the buttons rather than left behind,
          which would have held the spinner to 56% of the width with the rest blank.
        -->
        <LinearLayout
            android:id="@+id/button_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_note_title"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:hint="Enter note title.."
            android:textColorHint="@android:color/darker_gray"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="250"
            android:maxLines="10"
            android:gravity="top|start"
            android:background="@drawable/bg_edittext_amber"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:scrollHorizontally="false" />

    </LinearLayout>
</LinearLayout>
