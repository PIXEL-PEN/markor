<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar tab.

  Two things this layout has to survive. The FAB floats 128dp up from the bottom of the window,
  so nothing the user types into may sit under it. And the activity is adjustResize, so when the
  keyboard opens the whole fragment loses roughly half its height.

  The first version solved the FAB by giving the text field layout_weight, which made the second
  problem worse than the one it fixed: a weighted field in a shrinking parent is the first thing
  squeezed, and the keyboard flattened it to nothing. Fixed height inside a ScrollView instead.
  The field keeps its size whatever the window does, and focusing it scrolls it into view above
  the keyboard rather than resizing it out of existence.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".activity.CalendarFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <net.pixelpen.journal.view.MonthGrid
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_calendar_card"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp" />

        <!-- Category row, with the settings button alongside rather than on a line of its own. -->
        <LinearLayout
            android:id="@+id/button_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_chip" />

            <ImageButton
                android:id="@+id/btn_manage_categories_toolbar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/manage_categories"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_black_24dp" />

        </LinearLayout>

        <EditText
            android:id="@+id/input_note_title"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_edittext_amber"
            android:gravity="top|start"
            android:hint="@string/enter_note_title"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="250"
            android:maxLines="10"
            android:overScrollMode="always"
            android:padding="10dp"
            android:scrollHorizontally="false"
            android:scrollbars="vertical"
            android:textColorHint="@color/cal_weekday" />

    </LinearLayout>

</ScrollView>
