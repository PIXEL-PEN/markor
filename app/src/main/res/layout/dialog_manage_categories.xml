<?xml version="1.0" encoding="utf-8"?>
<!--
  Manage categories.

  Was a console: an Action spinner over From, Target and New name, three controls whose meaning
  changed with the verb, and a Preview button that printed absolute paths. This is the list
  instead, so the thing being acted on is the thing you touch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/mc_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <TextView
        android:id="@+id/mc_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/no_categories_yet"
        android:textColor="@color/cal_weekday"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mc_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:selectableItemBackground"
        android:drawableStart="@drawable/ic_baseline_add_24"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/add_category"
        android:textColor="@color/cal_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
