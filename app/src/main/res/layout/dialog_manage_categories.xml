<?xml version="1.0" encoding="utf-8"?>
<!--
  Manage categories.

  Was a console: an Action spinner over From, Target and New name, three controls whose meaning
  changed with the verb, and a Preview button that printed absolute paths. This is the list
  instead, so the thing being acted on is the thing you touch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!--
      wrap_content, with a ceiling applied in code.

      The Add row below this used to be unreachable: the list grew to its full content
      height and pushed it past the bottom of the dialog, which is why an imported archive
      appeared to have no way to add anything. A weight would fix that only if this view's
      parent were bounded, and making the root match_parent gives every short list a
      full-height dialog with a gap above the Add row. So the height is capped in
      onCreateDialog instead: short lists stay compact, long ones scroll.
    -->
    <ScrollView
        android:id="@+id/mc_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <!--
          minHeight so the dialog does not open as a thin strip and then jump. The rows are
          fetched on a background thread, so for the first moment this really is empty.
        -->
        <LinearLayout
            android:id="@+id/mc_list"
            android:minHeight="180dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <TextView
        android:id="@+id/mc_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/no_categories_yet"
        android:textColor="@color/cal_weekday"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mc_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:selectableItemBackground"
        android:drawableStart="@drawable/ic_baseline_add_24"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/add_category"
        android:textColor="@color/cal_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!--
      Only shown when the spinner is missing categories that exist on disk. It was in a
      popup behind a LONG PRESS on the gear, which is to say nowhere: a tap opens this
      dialog, so this dialog is where someone looking at the imported categories is.
    -->
    <TextView
        android:id="@+id/mc_sync"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:selectableItemBackground"
        android:drawableStart="@drawable/ic_baseline_add_24"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/add_all_to_spinner"
        android:textColor="@color/cal_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
