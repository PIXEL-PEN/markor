<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quicknote widget: a cream bar reading "Quicknote…", the Autumn logo at its end.
  A widget cannot take typing, so a tap opens QuicknoteEntryActivity exactly over this bar,
  drawn the same, with the keyboard up: the bar seems to become the field.
  Keep it in step with quicknote_entry.xml: same padding, sizes and text size.
  RemoteViews: only LinearLayout, TextView and ImageView in here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/qn_widget_pill"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/qn_widget_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:text="@string/qn_widget_hint"
        android:textColor="@color/qn_widget_hint"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/qn_widget_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/qn_widget_open"
        android:src="@mipmap/ic_launcher" />

</LinearLayout>
