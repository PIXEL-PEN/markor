<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quicknote widget, two cells: a cream bar reading "Quicknote…" with the Quicknote bolt
  on a navy tile at its end. A widget cannot take typing, so a tap opens the entry box
  (QuicknoteEntryActivity) across the top of the screen.
  RemoteViews: only LinearLayout, FrameLayout, TextView and ImageView in here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/qn_widget_pill"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/qn_widget_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:text="@string/qn_widget_hint"
        android:textColor="@color/qn_widget_hint"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/qn_widget_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/qn_widget_tile"
        android:contentDescription="@string/qn_widget_open">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_quicknote" />
    </FrameLayout>

</LinearLayout>
