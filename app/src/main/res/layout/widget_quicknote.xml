<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quicknote widget: the Autumn logo with a note badge. A widget cannot take typing, so a
  tap opens the entry box (QuicknoteEntryActivity), where the field is.
  RemoteViews: only FrameLayout and ImageView in here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/qn_widget_logo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@string/qn_widget_open"
        android:src="@mipmap/ic_launcher" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/qn_widget_badge" />

</FrameLayout>
