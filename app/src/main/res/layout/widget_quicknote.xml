<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quicknote widget, two cells: the Autumn logo with a note badge, and the word Quicknote.
  A widget cannot take typing, so a tap opens the entry box (QuicknoteEntryActivity).
  The badge sits inside the logo's own frame so the launcher's cell cannot clip it.
  RemoteViews: only LinearLayout, FrameLayout, TextView and ImageView in here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/qn_widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="14dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/qn_widget_logo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="top|start"
            android:contentDescription="@string/qn_widget_open"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:importantForAccessibility="no"
            android:src="@drawable/qn_widget_badge" />
    </FrameLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/quicknote"
        android:textColor="@color/qn_widget_badge_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
