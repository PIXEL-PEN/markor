<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/welcome_strong"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcome__skip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="@string/welcome_skip"
            android:textColor="@color/welcome_title"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/welcome__pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/welcome__dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/welcome__nav_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/welcome__dont_show"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="@string/welcome_dont_show"
            android:textColor="@color/welcome_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/welcome__next"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/welcome_button_bg"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/welcome_next"
            android:textColor="@color/welcome_button_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/welcome__final"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/welcome__allow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/welcome_button_bg"
            android:gravity="center"
            android:text="@string/welcome_allow"
            android:textColor="@color/welcome_button_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcome__not_now"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/welcome_not_now"
            android:textColor="@color/welcome_dim"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
