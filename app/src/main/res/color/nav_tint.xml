<?xml version="1.0" encoding="utf-8"?>
<!--
  The same two tints as drawable/bottomnav_color_selector, but in res/color, which is where
  a ColorStateList belongs.

  That matters: Material's own attributes (itemIconTint, itemTextColor) resolve a selector
  out of res/drawable happily, so the drawable-folder copy has always worked for them. The
  framework's VectorDrawable inflater, reading android:tint, wants a genuine colour resource
  and gets nothing from a drawable, so the icons tinted themselves with nothing and went
  invisible on the bar.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/nav_active" android:state_checked="true" />
    <item android:color="@color/nav_inactive" />
</selector>
