<resources>
    

    <!--
      Three, and each one does what it says. The six this replaced included Auto
      (MODE_NIGHT_AUTO, deprecated, wanting a location the app never asks for), Auto
      (09:00 - 17:00) with the hours written into the code, and Black, which differed from
      Dark by a single branch returning Color.BLACK for the editor background.

      system is first and is the default, so the phone's dark-mode switch works without
      anyone opening Settings.
    -->
    <string-array name="pref_arrdisp__app_themes" translatable="false">
        <item translatable="false">System</item>
        <item translatable="false">@string/light</item>
        <item translatable="false">@string/dark</item>
    </string-array>

