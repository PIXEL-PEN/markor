<resources>
    <!-- Named colors -->
    <color name="colorPrimary">@color/primary</color>
    <color name="primary_text">@color/light__primary_text</color>
    <color name="secondary_text">@color/light__secondary_text</color>
    <color name="file">@color/light__file</color>
    <color name="folder">@color/light__folder</color>
    <color name="background">@color/light__background</color>
    <color name="background_2">@color/light__background_2</color>
    <color name="textActionBarColor">@color/lighter_grey</color>
    <color name="textActionIconColor">@color/grey</color>

    <!-- Named colors differing common to day and night -->
    <color name="colorAccent">@color/accent</color>

    <!-- Color values -->
    <color name="primary">#1E2135</color>
    <color name="primary_dark">#161828</color>
    <color name="primary_light">#CED9DD</color>
    <!--
      The app's accent. Was #F04B4B red; now the same slate blue-grey the Year and Timeline
      headers use, so the calendar's selected day, the FAB and the active bottom-nav tab are one
      colour instead of three opinions.
    -->
    <color name="accent">#44546A</color>

    <!-- Calendar grid -->
    <color name="cal_accent">#44546A</color>
    <color name="cal_title">#2B3545</color>
    <color name="cal_day">#30383F</color>
    <color name="cal_weekday">#8A95A1</color>
    <color name="cal_day_selected_text">#FFFFFF</color>
    <color name="cal_day_marked_bg">#E4EAF0</color>
    <color name="cal_card_bg">#FBFCFD</color>
    <color name="cal_card_border">#DCE3EA</color>
    <color name="cal_chip_bg">#EDF1F6</color>
    <color name="cal_chip_border">#B6C2D0</color>

    <!-- Bottom bar, on the navy @color/primary -->
    <color name="nav_active">#CBDAEE</color>
    <color name="nav_inactive">#8C97A6</color>
    <color name="icons">#FFFFFF</color>
    <color name="divider">#B6B6B6</color>

    <color name="accent_light">#FF9800</color>
    <color name="divider_2">#3D3D3D</color>
    <color name="default_link_color">#388E3C</color>

    <color name="light__background">#EEEEEE</color>
    <color name="light__background_2">#F9F9F9</color>
    <color name="light__primary_text">#212121</color>
    <color name="light__secondary_text">#757575</color>
    <color name="light__file">#757575</color>
    <color name="light__folder">#757575</color>

    <color name="dark__background">#222222</color>
    <color name="dark__background_2">#424242</color>
    <color name="dark__primary_text">@color/white</color>
    <color name="dark__secondary_text">#9E9E9E</color>
    <color name="dark__file">#9E9E9E</color>
    <color name="dark__folder">#9E9E9E</color>


    <color name="white">#FFFFFFFF</color>
    <color name="black">#000000</color>
    <color name="grey">#FF505050</color>
    <color name="dark_grey">#FF212121</color>
    <color name="light_grey">#FFC0C0C0</color>
    <color name="lighter_grey">#FFE0E0E0</color>

    <color name="solarized_bg_dark">#002B36</color>
    <color name="solarized_bg_light">#FCF5E4</color>
    <color name="solarized_fg">#657B83</color>
    <color name="gruvbox_bg_dark">#282828</color>
    <color name="gruvbox_fg_dark">#EBDBB2</color>
    <color name="gruvbox_bg_light">#FBF1C7</color>
    <color name="gruvbox_fg_light">#3C3836</color>
    <color name="green_dark">#00FF00</color>
    <color name="green_light">#00BB00</color>

    <color name="sepia_fg_light__bg_dark">#282828</color>
    <color name="sepia_bg_light__fg_dark">#EBDBB2</color>

    <color name="nord_bg_dark">#2E3440</color>
    <color name="nord_fg_dark">#ECEFF4</color>
    <color name="nord_bg_light">#ECEFF4</color>
    <color name="nord_fg_light">#2E3440</color>

    <color name="link">#FF1EA3FD</color>
    <color name="transparent">#00FFFFFF</color>
    <color name="dark_green">#006400</color>

    <!--
      Folder tree. These were literals in the stylesheet the tree used to generate; they are named
      here so the native rows and any later theming read from one place.
    -->
    <color name="tree_accent">#D35400</color>
    <color name="tree_title">#222222</color>
    <color name="tree_icon">#1C1C1C</color>
    <color name="tree_meta">#6E6E6E</color>
    <color name="tree_divider">#DDDDDD</color>

    <!--
      Year overview. Taken from the stylesheet year.py generated, so the native screen reads as
      the same screen rather than a reinterpretation of it.
    -->
    <color name="year_header">#005F73</color>
    <color name="year_dropdown">#0A9396</color>
    <color name="year_highlight_bg">#E0FBFC</color>
    <color name="year_month_bg">#D0F4DE</color>
    <color name="year_month_border">#A3C4BC</color>
    <color name="year_page_bg">#F4F4F4</color>
    <color name="year_slot_empty">#9AB3B8</color>

    <!-- Life timeline. Sampled from the HTML this screen replaces. -->
    <color name="tl_header">#44546A</color>
    <color name="tl_decade">#B08D0F</color>
    <color name="tl_year">#92B4B8</color>
    <color name="tl_pill">#F7DD93</color>
    <color name="tl_page_bg">#EEF2F7</color>
    <color name="tl_card_border">#C9D2DC</color>
    <!-- The seeded month column. Subtle on purpose: it is a scaffold, not content. -->
    <color name="tl_gutter">#A9B4BF</color>

    <!--
      The year entry screen, a shade deeper than the timeline's page. White fields on a very pale
      page read as glare with nothing to separate them; dropping the page lets the fields come
      forward on their own instead of relying on a border to do it.
    -->
    <color name="tl_entry_bg">#D6DFE5</color>
    <color name="tl_entry_border">#A8B6C0</color>
    <color name="tl_entry_gutter">#5E6E79</color>


    <!-- Guide. Same teal and blue-grey family as the Year screen, deliberately, so the guide
         looks like part of the app rather than a help page bolted on. -->
    <color name="guide_page_bg">#F4F7F9</color>
    <color name="guide_title">#005F73</color>
    <color name="guide_heading">#0A9396</color>
    <color name="guide_body">#2B3545</color>
    <color name="guide_callout_bg">#E0FBFC</color>
    <color name="guide_callout_rule">#0A9396</color>
    <!-- Quicknote is an action, not a tab, and is coloured apart from the three
         destinations. Used by the bar icon fill and by the label span. -->
    <color name="nav_quicknote">#FFD400</color>

    <!-- The day card. -->
    <color name="day_card_ring">#AEB8C4</color>
    <color name="day_card_stroke">#D9DFE6</color>
    <color name="day_card_number">#2B3545</color>
    <color name="day_card_weekday">#5C6878</color>

    <!-- One band colour per month, walking from winter slate through spring green into the
         autumn the app is named for and back to pine. Every one carries white at 4.5:1 or
         better, so the month label needs no per-month text colour. May is the launcher's
         teal, so one month a year the app and its icon agree. -->
    <color name="band_jan">#2F4858</color>
    <color name="band_feb">#58405F</color>
    <color name="band_mar">#44624A</color>
    <color name="band_apr">#2F7A5B</color>
    <color name="band_may">#00695C</color>
    <color name="band_jun">#1C6B77</color>
    <color name="band_jul">#8A5E12</color>
    <color name="band_aug">#9E5330</color>
    <color name="band_sep">#8C3F28</color>
    <color name="band_oct">#9C4A1E</color>
    <color name="band_nov">#7A3344</color>
    <color name="band_dec">#2E5A46</color>
</resources>
